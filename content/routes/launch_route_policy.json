    "profile_schema": {
      "required_fields": ["id", "tier", "duration_ticks", "hazard_family_ids", "events"],
      "hazard_family_reference": "must resolve in LAUNCH_HAZARD_FAMILIES",
      "events_must_use_existing_family_grammar": true,
      "duration_ticks_max": 24
    }
  }
}
